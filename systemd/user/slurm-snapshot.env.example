# slurm-snapshot.env: parameters of the user unit slurm-snapshot.service. Copy this file to
# ~/.config/systemd/user/slurm-snapshot.env and set the three values; then
# `systemctl --user daemon-reload`. Absolute paths only: systemd expands no ~, $HOME or other
# variables here. Lines are KEY=VALUE; no quotes needed unless the value has spaces.

# The copy of the scripts directory: snapshot-bundle.sh, the *-snapshot.sh scripts, snapshot-lib.sh.
SNAPSHOT_SCRIPTS=/nfs/home/alice/slurm-snapshot

# The work root. Each cycle writes SNAPSHOT_ROOT/YYYY/MM/DD/<cluster>-<stamp>.tgz. Pick a
# filesystem with room: one bundle is a few MB on a large cluster, 96 bundles a day at 15 min.
SNAPSHOT_ROOT=/scratch/alice/slurm-snapshot-data

# The sacct window, as sacct-snapshot.sh accepts it. It should overlap the timer interval.
SNAPSHOT_SINCE=now-2hours
